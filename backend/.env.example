# Copy to backend/.env, or run `python scripts/init_env.py` which does it for you with a real
# SECRET_KEY and a file only you can read. Never commit backend/.env.
PROJECT_NAME="AI-ITMonitor"
API_V1_STR="/api/v1"

# "development" prints warnings about weak settings; "production" refuses to start with them.
ENVIRONMENT=development

# JWT signing key: at least 32 random characters. Leave EMPTY here: scripts/init_env.py fills it in,
# and the server refuses to start if it is a placeholder or too short. Anyone who knows this
# value can sign a valid administrator token.
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_SERVER=localhost
POSTGRES_USER=ai_itmonitor
# Replace this with a strong password (the server flags this default value).
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ai_itmonitor_db
POSTGRES_PORT=5432

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:1b"

# Shared key agents must send (X-Agent-Key). While it is empty ANYONE who can reach the API can
# enrol an agent. Set it (python scripts/init_env.py --with-agent-key) and give every agent the
# same value as its AGENT_API_KEY environment variable. Required when ENVIRONMENT=production.
AGENT_API_KEY=

# JSON array of allowed browser origins, e.g. ["http://localhost:5173"]. "*" is fine on a closed
# LAN but is reported in production.
CORS_ORIGINS=["*"]
